# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# MLflow tracking server (local by default; point at your EC2 server later)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Which model serves predictions: transformer (default), local (LightGBM pickles), registry (MLflow)
MODEL_SOURCE=transformer
TRANSFORMER_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
